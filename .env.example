# AI 接入环境变量示例（复制为 .env 后填值，diagnosis_layer 启动时会自动读取）
# 仅填 OPENAI_API_KEY 即可（base_url 自动补为 https://api.openai.com/v1）

# --- LLM（必需：产出结构化诊断）---
LLM_API_KEY=sk-xxxx
# 非 OpenAI 兼容端点时显式指定：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Embedding（可选：升级 RAG 为语义检索，留空则关键词回退）---
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# --- 知识库路径（可选，覆盖默认 docs/medical）---
# MEDICAL_CORPUS_DIR=/abs/path/to/medical
