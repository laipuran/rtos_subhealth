# OpenAI-compatible AI 接入模板
# 1) 复制为 .env：cp .env.example .env
# 2) 把下面的占位符替换成真实的 key / endpoint
# 3) 启动脚本会自动读取，diagnosis_layer 会按这个配置接入模型

# --- LLM（必需：结构化诊断输出）---
# OpenAI 兼容接口常用写法：
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 项目当前也支持显式的 LLM_* 变量：
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Embedding（可选：用于 RAG 语义检索）---
# 如果你不想启用 embedding，可以直接留空，系统会自动回退到关键词检索
EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- 医学知识库路径（可选，默认会读取 docs/medical）---
# MEDICAL_CORPUS_DIR=/home/you/project/docs/medical
