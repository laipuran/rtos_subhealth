{
    "name": "ros-subhealth (Jazzy + Rust)",
    "dockerComposeFile": "../docker/dev/compose.yaml",
    "service": "dev",
    "workspaceFolder": "/workspace",
    "remoteUser": "ubuntu",
    "updateRemoteUserUID": true,
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer"
            ],
            "settings": {
                "rust-analyzer.linkedProjects": [
                    "Cargo.toml"
                ],
                "rust-analyzer.showUnlinkedFileNotification": false
            }
        }
    },
    "postCreateCommand": "sudo chown -R ubuntu:ubuntu /ws /usr/local/cargo /usr/local/rustup 2>/dev/null || true"
}
