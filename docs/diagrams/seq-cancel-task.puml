@startuml
title 取消任务流程

actor WebUI as wui
participant "Desc Layer" as desc
participant "Exec Layer" as exec
participant "Motion Control" as hw

== 执行中取消 ==

exec -> hw : _drive_segment
activate hw
wui -> desc : POST cancel
activate desc
note right: HTTP 200 cancel_accepted
desc -> exec : action cancel /exec_task
activate exec
exec -> hw : stop motion
deactivate hw
hw --> exec : stopped
exec -> exec : handle_cancel
exec --> desc : result final_state=canceled
deactivate exec
desc -> wui : WS push final_state=canceled
deactivate desc

note right #eeffee: WebUI 也可\n通过 GET 查询终态

@enduml
