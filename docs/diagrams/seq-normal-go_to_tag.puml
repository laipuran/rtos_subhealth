@startuml
title 正常 go_to_tag 流程

actor WebUI as wui
participant "Desc Layer" as desc
participant "Exec Layer" as exec
participant "Planner" as plan
participant "Motion Control" as hw

== 任务下发 ==

wui -> desc : POST /api/v1/tasks
note right: HTTP 201, task_id=T-001
desc -> exec : action goal /exec_task
note right: state=accepted
exec -> plan : service /plan_path
activate plan
plan --> exec : segments, next_tag=42
deactivate plan

== 执行循环 ==

exec -> hw : _drive_segment
activate hw
exec -> desc : feedback state=running
desc -> wui : WS push state=running
hw --> exec : segment done
deactivate hw
exec -> desc : feedback current_tag=42
desc -> wui : WS push current_tag=42

== 完成 ==

exec --> desc : result final_state=succeeded
desc -> wui : WS push final_state=succeeded

@enduml
