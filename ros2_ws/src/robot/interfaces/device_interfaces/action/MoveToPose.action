# Move to a pose in a named frame. Optional capability: only devices advertising
# `move_to_pose` + `supports_pose` implement this.
# Goal
string goal_id
geometry_msgs/PoseStamped target
float32 position_tolerance_m
float32 yaw_tolerance_rad
int64 deadline_ms
---
# Result
string final_state
string error_code
string message
---
# Feedback
string state
float32 progress
float32 distance_remaining_m
string error_code
string message
