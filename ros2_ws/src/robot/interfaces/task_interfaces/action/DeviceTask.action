# Single device-agnostic task. The orchestrator routes this to the adapter named
# by `device_id`, validated against the device's advertised primitives.
# Goal
string goal_id
string device_id
string primitive              # move_to_pose | set_velocity | hold | stop | execute_primitive
device_interfaces/TaskTarget target
string params_json            # primitive-specific extras (JSON object)
task_interfaces/Constraints constraints
int64 deadline_ms
---
# Result
string final_state
string error_code
string message
---
# Feedback
string state
float32 progress
string phase
string error_code
string message
