<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gateway_bridge</name>
  <version>0.1.0</version>
  <description>Runs the HTTP/WS gateway and bridges device tasks to the orchestrator over ROS 2.</description>
  <maintainer email="dev@ros-subhealth.local">ROS Subhealth</maintainer>
  <license>Apache-2.0</license>

  <depend>rclrs</depend>
  <depend>rosidl_runtime_rs</depend>
  <depend>task_interfaces</depend>
  <depend>device_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
