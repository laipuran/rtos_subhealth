# AI 接入环境变量（复制为 .env 后填值）
# .env 由 run.sh 加载到 shell 环境，diagnosis_layer 启动后从环境变量读取

# --- LLM（必需：产出结构化诊断）---
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini

# 国内大模型示例（兼容 OpenAI 接口）：
# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat
# --- 通义千问 ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=qwen-turbo

# --- 代理（国内访问 OpenAI 时需要）---
# 直接由 llm_client.py 读取，不经过 build_config()
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# --- Embedding（可选：升级 RAG 为语义检索，留空则关键词回退）---
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_BASE_URL=https://api.openai.com
# EMBEDDING_MODEL=text-embedding-3-small

# --- 知识库路径（可选，覆盖默认 docs/medical）---
# MEDICAL_CORPUS_DIR=/abs/path/to/medical
