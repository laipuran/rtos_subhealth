[Unit]
Description=ROS Subhealth endpoint runtime (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ros-subhealth
EnvironmentFile=/etc/ros/endpoint-%i.env
ExecStart=/usr/bin/endpoint-runtime
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
