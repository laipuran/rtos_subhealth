# Runtime environment for gateway. Secrets are NOT kept here; they are
# provided as systemd credentials (see gateway.service).

# DDS settings for the robot link.
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_DOMAIN_ID=1

# Where the gateway persists state and reads the tag graph / WebUI.
GATEWAY_DB_DIR=/var/lib/ros
GATEWAY_MAPS_DIR=/var/lib/ros/maps
GATEWAY_WEBUI_DIR=/usr/share/ros-webui
GATEWAY_HTTP_PORT=5000
GATEWAY_EXEC_ACTION=exec_task
